{
  "name": "sauce-uidemo-taf",
  "version": "1.0.0",
  "private": true,
  "description": "Test automation for sauce-uidemo — generated by Applause AI on the applause-ai-taf framework.",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:bs": "playwright test --config playwright.browserstack.config.ts",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report",
    "report:allure": "allure generate allure-results --clean -o allure-report && allure open allure-report",
    "report:allure:ci": "allure generate allure-results --clean -o allure-report",
    "test:test": "TEST_ENV=test playwright test",
    "test:bs:test": "TEST_ENV=test playwright test --config playwright.browserstack.config.ts",
    "test:default": "TEST_ENV=default playwright test",
    "test:bs:default": "TEST_ENV=default playwright test --config playwright.browserstack.config.ts"
  },
  "author": "Applause",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.2",
    "allure-commandline": "^2.32.0",
    "allure-playwright": "^3.0.0",
    "dotenv": "^17.4.2",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  }
}
